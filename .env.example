# URL de base de l'API BTT-LUX (sans slash final).
#
# Ordre de priorité appliqué par src/services/api.js :
#   1. EXPO_PUBLIC_API_URL (cette variable)
#   2. sur le web -> proxy local http://localhost:3002/api (contourne le CORS)
#      sur natif -> expo.extra.apiUrl de app.json
#   3. repli intégré (http://localhost:3002/api)
#
# Exemples :
#   EXPO_PUBLIC_API_URL=http://localhost:3002/api
#   EXPO_PUBLIC_API_URL=https://btt-backend-sgas.onrender.com/api
#
# Copiez ce fichier en « .env » et renseignez la valeur souhaitée.
EXPO_PUBLIC_API_URL=

# --- Connexion rapide de développement (bouton « Connexion admin (dev) ») ---
# Utilisée uniquement dans les builds de développement (garde __DEV__) : le
# bouton et ces identifiants sont retirés des builds de production.
# Aucun mot de passe de repli n'est embarqué dans les sources : si ces valeurs
# sont vides, le bouton reste inopérant en développement. Renseignez-les dans
# votre .env local (jamais commité) pour activer le raccourci.
EXPO_PUBLIC_DEV_ADMIN_EMAIL=
EXPO_PUBLIC_DEV_ADMIN_PASSWORD=
